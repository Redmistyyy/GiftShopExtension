<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="5.0.0-pre.202610101655" />
    <PackageReference Include="SPTushonka.DI" Version="5.0.0-pre.202610101655" />
    <PackageReference Include="SPTushonka.Server.Core" Version="5.0.0-pre.202610101655" />
    <PackageReference Include="SPTushonka.Reflection" Version="5.0.0-pre.202610101655" />
  </ItemGroup>

  <ItemGroup>
    <None Update="GiftContent\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**\*.png;Images\**\*.webp;Images\**\*.jpg;Images\**\*.jpeg;Images\**\*.gif;Images\**\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Gifts\customGifts.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
