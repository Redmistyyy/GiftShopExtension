// ═══════════════════════════════════════════════════════════════
// TarcovStore 自定义礼物码定义
//
// 共 23 个礼物码（含来自 Additional-SPT-gifts 社区的导入）
//
// 格式说明：
//   "礼物码ID": {
//     "items": [  ← 道具列表
//       {
//         "_id":       "xxxxxxxxxxxxxxxxxxxxxxxx"  ← 唯一 MongoId
//         "_tpl":      "5449016a4bdc2d6f028b456f"  ← 模板 ID
//         "upd": { "StackObjectsCount": 50000 }    ← 可选属性
//         "parentId":  "yyyyyyyyyyyyyyyyyyyyyyyy"  ← 父物品 ID
//         "slotId":    "main"                      ← 根用 "main"
//       }
//     ],
//     "sender":         "System",
//     "messageText":    "领取时显示的消息",
//     "collectionTimeHours": 48,
//     "associatedEvent": "Promo",
//     "maxToSendPlayer": 1
//   }
//
// 注意事项：
//   - 所有 _id 和 parentId 必须使用合法的 MongoId（24 位十六进制）
//   - slotId="main" 的物品的 parentId 需指向某个根容器 ID
//   - 子物品（配件/弹药）的 parentId 指向其父物品的 _id
// ═══════════════════════════════════════════════════════════════
